{
  "type": "module",
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "redis": "^4.6.13",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "scripts": {
    "test": "jest --runInBand",
    "start": "node server.js",
    "check": "prettier --check .",
    "format": "prettier --write .",
    "vercel-build": "echo yay",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js --max-warnings 0",
    "test:ci": "jest --ci --runInBand --coverage --coverageReporters=text --coverageReporters=json-summary --json --outputFile=reports/unit-tests.json"
  },
  "jest": {
    "transform": {
      "^.+\\.js?$": "babel-jest"
    },
    "clearMocks": true,
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "coverageDirectory": "reports/coverage",
    "collectCoverageFrom": [
      "controllers/posts-controller.js",
      "utils/cache-posts.js"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.23.2",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3",
    "nodemon": "^3.0.1"
  }
}
